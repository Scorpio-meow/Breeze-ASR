# 複製成 .env 後修改；每個變數都必須填寫，說明見 docs/configuration.md

# 網頁服務；其他電腦要連線時 ASR_HOST 填 0.0.0.0
ASR_HOST=127.0.0.1
ASR_PORT=7860

# 模型與資料；硬體設定檔不存在時，第一次啟動會自動調校後寫出
ASR_MODELS_FILE=models.json
ASR_DATA_DIR=data
ASR_HARDWARE_PROFILE=data/hardware-profile.json

# 上限；結果保留的秒數
ASR_MAX_UPLOAD_MB=2048
ASR_MAX_AUDIO_SECONDS=10800
ASR_MAX_QUEUE=20
ASR_JOB_TTL_SECONDS=86400

# ASS 匯出與燒錄字幕的字型，名稱含空白要加引號
ASR_SUBTITLE_FONT="Microsoft JhengHei"
ASR_SUBTITLE_FONTS_DIR=C:/Windows/Fonts

# 監看資料夾，不用時填 off；說話者：off、auto 或人數；格式：txt、srt、vtt、ass、md、docx、json
ASR_WATCH_DIR=off
ASR_WATCH_MODEL=MediaTek-Research/Breeze-ASR-25
ASR_WATCH_SPEAKERS=auto
ASR_WATCH_PUNCTUATION=on
ASR_WATCH_FORMATS=srt,md,json
ASR_WATCH_POLL_SECONDS=10

# Hugging Face
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# 只有 Docker 版會用到；ASR_TORCH_GROUP：cpu、cu130 或 rocm72；ASR_DOCKER_SUBNET 要避開內部網路的網段
COMPOSE_FILE=compose.yaml
ASR_TORCH_GROUP=cpu
ASR_IMAGE=breeze-asr-webapp:cpu
ASR_MODELS_SOURCE=./models.json
ASR_PUBLISH_ADDRESS=127.0.0.1
ASR_PUBLISH_PORT=7860
ASR_DOCKER_SUBNET=192.168.202.0/24
