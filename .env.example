# 個人電腦用的設定。複製成 .env 後依環境調整；缺少必要設定時服務會拒絕啟動。
# 推論引擎與裝置由自動調校決定，寫在 ASR_HARDWARE_PROFILE 指向的檔案。

# ===== 網頁服務 =====
# 原生執行時的監聽位址：只給本機用填 127.0.0.1；要讓其他電腦連線填 0.0.0.0
ASR_HOST=127.0.0.1
# 服務埠（Docker 版是容器內的埠）
ASR_PORT=7860

# ===== 模型與推論 =====
# 可切換的模型清單（含固定版本、解碼語言、介面說明）
ASR_MODELS_FILE=models.json
# 下載的權重以外的資料：轉換後的 OpenVINO 模型、編譯快取、辨識結果與上傳暫存
ASR_DATA_DIR=data
# 硬體設定檔（推論引擎、裝置、精度、同時常駐的模型數）。
# 檔案不存在時，第一次啟動會自動偵測硬體並實測各裝置後寫出；也可以手寫這個檔案固定設定
ASR_HARDWARE_PROFILE=data/hardware-profile.json

# ===== 使用限制 =====
ASR_MAX_UPLOAD_MB=2048
ASR_MAX_AUDIO_SECONDS=10800
# 最多可排隊的工作數
ASR_MAX_QUEUE=20
# 完成的辨識結果保留多久（秒），過期後無法再下載
ASR_JOB_TTL_SECONDS=86400

# ===== Hugging Face =====
HF_HUB_DISABLE_TELEMETRY=1
# 關閉 Windows 無法建立符號連結時的快取警告：快取改用複製檔案，每個模型只固定一個版本，不會多佔空間
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ===== 只有 Docker 版會用到 =====
COMPOSE_FILE=compose.yaml
# 映像檔裡的 PyTorch 版本：cpu、cu130（NVIDIA CUDA）或 rocm72（AMD ROCm，僅 Linux）
ASR_TORCH_GROUP=cpu
# 映像檔名稱：自己建置時任取，例如 breeze-asr-webapp:cpu；使用 GitHub 發布的映像檔時填 ghcr.io/<owner>/<repo>:cpu、:cuda 或 :rocm
ASR_IMAGE=breeze-asr-webapp:cpu
# 掛進容器的模型清單
ASR_MODELS_SOURCE=./models.json
# 對外發布的位址與埠：只給本機用填 127.0.0.1；要讓其他電腦連線填 0.0.0.0
ASR_PUBLISH_ADDRESS=127.0.0.1
ASR_PUBLISH_PORT=7860
# 容器網段，必須避開內部網路使用中的網段
ASR_DOCKER_SUBNET=192.168.202.0/24
